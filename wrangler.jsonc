{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "drushti-creatives",
  "compatibility_date": "2025-08-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CONTENT_PROVIDER": "payload",
    "NEXT_PUBLIC_SERVER_URL": "https://drushti-creatives.example.com"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "drushti-creatives",
      "database_id": "FILL_AFTER_WRANGLER_D1_CREATE",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "drushti-creatives-media"
    }
  ]
}
