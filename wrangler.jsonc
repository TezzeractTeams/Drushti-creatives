{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "drushti-creatives",
  "compatibility_date": "2025-08-05",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "CONTENT_PROVIDER": "static",
    "NEXT_PUBLIC_SERVER_URL": "https://drushti-creatives.example.com"
  }
}
