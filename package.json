{
  "name": "drushti-creatives",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "npm run cf-typegen && cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "next lint",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/seed-portfolio.ts",
    "setup": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/setup-payload.ts",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "preview": "npm run cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:database": "cross-env NODE_ENV=production PAYLOAD_SECRET=ignore payload migrate && wrangler d1 execute D1 --command 'PRAGMA optimize' --remote",
    "deploy:app": "npm run cf-typegen && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy": "npm run deploy:app",
    "deploy:full": "npm run deploy:database && npm run deploy:app",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.11.0",
    "@payloadcms/db-d1-sqlite": "3.86.0",
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-r2": "3.86.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.8.1",
    "i": "^0.3.7",
    "lenis": "^1.3.25",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "15.5.22",
    "payload": "3.86.0",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.34.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "15.5.22",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5",
    "wrangler": "^4.61.1"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom"
  }
}
