PAYLOAD_SECRET=change-me-to-a-long-random-string
DATABASE_URL=file:./payload.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
CONTENT_PROVIDER=payload

# Shared dev password for admin users listed in data/payload/seed-users.json
PAYLOAD_SEED_PASSWORD=dev-admin-change-me

# --- Cloudflare production (set via wrangler.jsonc vars / dashboard / secrets) ---
# PAYLOAD_SECRET          → wrangler secret put PAYLOAD_SECRET
# CONTENT_PROVIDER=payload
# NEXT_PUBLIC_SERVER_URL=https://your-production-domain.com
# D1 and R2 are bound in wrangler.jsonc — no DATABASE_URL on Cloudflare
